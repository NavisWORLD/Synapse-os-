#!/bin/sh
set -eu
BASE=/usr/share/synapse/apple-intel
[ -d "$BASE" ] || exit 0
find "$BASE" -type f \( -name '*.sh' -o -name '*.command' \) -exec chmod 0755 {} \;
ln -sf "$BASE/hardware/preflight_mac.sh" /usr/local/bin/synapse-apple-preflight
ln -sf "$BASE/hardware/diagnostics_mac.sh" /usr/local/bin/synapse-apple-diagnostics
ln -sf "$BASE/INSTALL_SYNAPSE_MAC.sh" /usr/local/bin/synapse-apple-install
ln -sf "$BASE/RECOVER_SYNAPSE_MAC.sh" /usr/local/bin/synapse-apple-recover
