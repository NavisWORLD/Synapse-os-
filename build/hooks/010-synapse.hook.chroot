#!/bin/sh
set -eu

chmod 0755 /usr/local/bin/synapse
chmod 0755 /usr/local/bin/synapse-control
chmod 0755 /usr/local/lib/synapse/vm-smoke
chmod 0755 /usr/local/lib/synapse/zeref-runtime
chmod 0755 /usr/local/lib/synapse/zeref-ibm-broker
mkdir -p /var/lib/synapse/zeref/ibm /etc/synapse/secrets
chmod 0755 /var/lib/synapse /var/lib/synapse/zeref /var/lib/synapse/zeref/ibm
chmod 0700 /etc/synapse/secrets

# /run is volatile. The tmpfiles rule recreates /run/synapse on every boot.
# Correct the legacy unit ordering in the generated image so the agent starts
# before multi-user.target completes instead of ordering itself after the target
# that pulls it in.
python3 - <<'PYUNIT'
from pathlib import Path
unit = Path('/etc/systemd/system/synapse-agent.service')
text = unit.read_text(encoding='utf-8')
old = 'After=multi-user.target\n'
new = 'After=local-fs.target\n'
if old not in text:
    raise SystemExit('expected Synapse agent ordering line not found')
unit.write_text(text.replace(old, new, 1), encoding='utf-8')
PYUNIT

systemctl enable synapse-agent.service
systemctl enable synapse-vm-smoke.service
# The broker is boot-enabled but has a ConditionPathExists guard, so no IBM
# operation occurs on machines where the owner has not provisioned a credential.
systemctl enable zeref-ibm-broker.service
# Install the resident runtime for every desktop user. Its launcher exits cleanly
# with MODEL_UNAVAILABLE until the required runtime command is present.
systemctl --global enable zeref-runtime.service
systemctl enable NetworkManager.service || true
systemctl enable sddm.service || true
systemctl enable power-profiles-daemon.service || true

mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/10-synapse-nebula.conf <<'EOF'
[Theme]
Current=synapse-nebula
CursorTheme=breeze_cursors
EOF

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  plymouth-set-default-theme synapse-nebula || true
fi

mkdir -p /etc/default/grub.d
cat > /etc/default/grub.d/50-synapse-theme.cfg <<'EOF'
GRUB_THEME="/usr/share/grub/themes/synapse-nebula/theme.txt"
GRUB_TIMEOUT=5
EOF

mkdir -p /etc/skel/Desktop
cp /usr/share/applications/install-synapse.desktop /etc/skel/Desktop/Install-Synapse-OS.desktop
cp /usr/share/applications/synapse-control.desktop /etc/skel/Desktop/Synapse-Control.desktop
cp /usr/share/applications/synapse-recovery.desktop /etc/skel/Desktop/Synapse-Recovery.desktop
cp /usr/share/applications/cosmos.desktop /etc/skel/Desktop/COSMOS.desktop
chmod +x /etc/skel/Desktop/*.desktop
