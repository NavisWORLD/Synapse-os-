[Unit]
Description=Synapse OS telemetry agent
After=multi-user.target

[Service]
Type=simple
Environment=PYTHONPATH=/usr/lib/synapse/python
ExecStart=/usr/bin/python3 -m synapse.agent --interval 5 --output /run/synapse/status.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/synapse

[Install]
WantedBy=multi-user.target
