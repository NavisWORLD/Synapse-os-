[Unit]
Description=Synapse OS phone bootstrap API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONPATH=/usr/lib/synapse/python
EnvironmentFile=-%h/.config/synapse/phone-bootstrap.env
ExecStart=/usr/bin/python3 -m synapse.phone_bootstrap --listen 0.0.0.0 --port 8787 --allow-install --activate --install-root %h/COSMOS --token-file %t/synapse-phone-bootstrap-token
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
