// Synapse Nebula / native Plymouth script. No external assets or compositor.
Window.SetBackgroundTopColor(0.005, 0.008, 0.034);
Window.SetBackgroundBottomColor(0.015, 0.035, 0.11);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
origin = Plymouth.GetTime();

// Asterisms and a soft double-rendered signature: all drawable with the
// default Plymouth font and the same renderer as the previous static splash.
star_image = Image.Text("+", 0.38, 0.71, 0.95);
star_a = Sprite(star_image);
star_a.SetX(screen_w * 0.13);
star_a.SetY(screen_h * 0.24);
star_b = Sprite(star_image);
star_b.SetX(screen_w * 0.76);
star_b.SetY(screen_h * 0.18);
star_c = Sprite(star_image);
star_c.SetX(screen_w * 0.82);
star_c.SetY(screen_h * 0.75);
star_d = Sprite(star_image);
star_d.SetX(screen_w * 0.21);
star_d.SetY(screen_h * 0.71);

beacon = Image.Text("*", 0.47, 0.86, 1.00);
beacon_sprite = Sprite(beacon);
beacon_sprite.SetX(screen_w / 2 - beacon.GetWidth() / 2);
beacon_sprite.SetY(screen_h / 2 - 104);

glow = Image.Text("SYNAPSE OS", 0.21, 0.56, 0.95);
glow_sprite = Sprite(glow);
glow_sprite.SetX(screen_w / 2 - glow.GetWidth() / 2);
glow_sprite.SetY(screen_h / 2 - 53);

logo = Image.Text("SYNAPSE OS", 0.92, 0.97, 1.00);
logo_sprite = Sprite(logo);
logo_sprite.SetX(screen_w / 2 - logo.GetWidth() / 2);
logo_sprite.SetY(screen_h / 2 - 54);

sub = Image.Text("NEBULA  //  COSMOS  //  CST", 0.38, 0.82, 1.00);
sub_sprite = Sprite(sub);
sub_sprite.SetX(screen_w / 2 - sub.GetWidth() / 2);
sub_sprite.SetY(screen_h / 2 + 6);

status = Image.Text("awakening synapses", 0.55, 0.64, 0.82);
status_sprite = Sprite(status);
status_sprite.SetX(screen_w / 2 - status.GetWidth() / 2);
status_sprite.SetY(screen_h / 2 + 56);

fun refresh_callback () {
  elapsed = Plymouth.GetTime() - origin;
  fade = elapsed / 1.6;
  if (fade > 1.0) fade = 1.0;
  if (fade < 0.0) fade = 0.0;

  heartbeat = 0.5 + 0.5 * Math.Sin(elapsed * 2.4);
  beacon_sprite.SetOpacity(fade * (0.25 + 0.75 * heartbeat));
  glow_sprite.SetOpacity(fade * (0.08 + 0.22 * heartbeat));
  logo_sprite.SetOpacity(fade);
  sub_sprite.SetOpacity(fade * 0.85);
  status_sprite.SetOpacity(fade * (0.48 + 0.50 * heartbeat));

  star_a.SetOpacity(0.13 + 0.25 * (0.5 + 0.5 * Math.Sin(elapsed * 1.1)));
  star_b.SetOpacity(0.13 + 0.30 * (0.5 + 0.5 * Math.Sin(elapsed * 1.8 + 1.8)));
  star_c.SetOpacity(0.13 + 0.35 * (0.5 + 0.5 * Math.Sin(elapsed * 1.4 + 3.2)));
  star_d.SetOpacity(0.13 + 0.28 * (0.5 + 0.5 * Math.Sin(elapsed * 1.3 + 4.4)));
}
Plymouth.SetRefreshFunction(refresh_callback);

fun message_callback (text) {
  status = Image.Text(text, 0.55, 0.64, 0.82);
  status_sprite.SetImage(status);
  status_sprite.SetX(screen_w / 2 - status.GetWidth() / 2);
}
Plymouth.SetMessageFunction(message_callback);
