#!/usr/bin/env python3
"""Synapse OS welcome: an opt-in, unprivileged entry to installed applications.

This is a local Qt widget, not a model or a network dashboard. It never starts
a provider automatically and never reads API keys or privileged credentials.
"""
from __future__ import annotations

import argparse
import os
from pathlib import Path
import subprocess
import sys

from PyQt6.QtCore import Qt
from PyQt6.QtGui import QFont
from PyQt6.QtWidgets import (
    QApplication, QFrame, QHBoxLayout, QLabel, QPushButton, QVBoxLayout, QWidget
)

BEAST_RUNTIME = Path("/opt/synapse/beast-runtime/bin/beastbox")
BEAST_LAUNCHER = Path("/usr/local/bin/synapse-beastos-web")
STATE_MARKER = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "synapse" / "welcome-seen"


def launch(binary: str) -> bool:
    """Open a fixed first-party/standard desktop application as this user."""
    try:
        subprocess.Popen([binary], start_new_session=True,
                         stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except OSError:
        return False


def mark_seen() -> None:
    try:
        STATE_MARKER.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        STATE_MARKER.touch(mode=0o600, exist_ok=True)
    except OSError:
        # State persistence is noncritical; never break login.
        pass


class Welcome(QWidget):
    def __init__(self) -> None:
        super().__init__()
        self.setWindowTitle("Synapse OS // Welcome Home")
        self.setObjectName("root")
        self.setMinimumSize(440, 310)
        screen = QApplication.primaryScreen()
        area = screen.availableGeometry() if screen is not None else None
        self.resize(min(850, max(440, area.width() - 30)) if area else 740,
                    min(560, max(310, area.height() - 36)) if area else 500)
        self.setStyleSheet("""
            QWidget#root { background: #050a19; color: #e9f6ff; }
            QFrame#panel { background: #101b34; border: 1px solid #35527b;
                           border-radius: 16px; }
            QLabel#title { font-size: 34px; font-weight: 700; letter-spacing: 3px; }
            QLabel#subtitle { color: #73dcff; font-size: 13px; }
            QLabel#body { color: #bdd1e8; font-size: 13px; }
            QLabel#state { color: #afc2de; font-size: 12px; }
            QPushButton { background: #152f53; color: #eaf7ff;
                          border: 1px solid #3a789c; border-radius: 9px;
                          text-align: left; padding: 7px 11px; font-size: 13px; }
            QPushButton:hover { background: #24507d; border-color: #75e5ff; }
            QPushButton:focus { border: 2px solid #ad8bff; }
            QPushButton#primary { background: #14506b; border-color: #58e7ff; }
        """)

        outer = QVBoxLayout(self)
        outer.setContentsMargins(18, 12, 18, 12)
        outer.setSpacing(7)
        eyebrow = QLabel("NEBULA  /  COSMOS  /  BEAST BOX")
        eyebrow.setObjectName("subtitle")
        outer.addWidget(eyebrow)
        title = QLabel("SYNAPSE OS")
        title.setObjectName("title")
        outer.addWidget(title)
        copy = QLabel("Welcome home. Your desktop is the suit. Beast Box is the engine.")
        copy.setObjectName("body")
        outer.addWidget(copy)

        panel = QFrame()
        panel.setObjectName("panel")
        panel_layout = QVBoxLayout(panel)
        panel_layout.setContentsMargins(13, 9, 13, 9)
        panel_layout.setSpacing(5)
        model_text = ("Beast Box runtime: installed" if BEAST_RUNTIME.is_file()
                      else "Beast Box runtime: unavailable")
        info = QLabel(model_text + "\nModel: not verified or selected. Cloud and sensor access require separate setup.")
        info.setObjectName("state")
        info.setWordWrap(True)
        panel_layout.addWidget(info)

        self.notice = QLabel("")
        self.notice.setObjectName("state")
        self.notice.setWordWrap(True)

        primary_button = None
        for name, program, primary, shortcut in (
            ("OPEN BEAST BOX   /   AI COCKPIT   [ALT+B]", str(BEAST_LAUNCHER), True, "Alt+B"),
            ("SYNAPSE CONTROL   /   SYSTEM   [ALT+S]", "/usr/local/bin/synapse-control", False, "Alt+S"),
            ("FILES   /   DOLPHIN   [ALT+F]", "/usr/bin/dolphin", False, "Alt+F"),
            ("TERMINAL   /   KONSOLE   [ALT+T]", "/usr/bin/konsole", False, "Alt+T"),
        ):
            button = QPushButton(name)
            button.setShortcut(shortcut)
            if primary:
                button.setObjectName("primary")
                button.setDefault(True)
                primary_button = button
            button.clicked.connect(lambda _checked=False, binary=program: self.open_app(binary))
            panel_layout.addWidget(button)
        if primary_button is not None:
            primary_button.setFocus()
        panel_layout.addWidget(self.notice)
        outer.addWidget(panel)

        footer = QHBoxLayout()
        legal = QLabel("Local-first. Explicit permissions. No model is granted OS authority.")
        legal.setObjectName("state")
        legal.setWordWrap(True)
        footer.addWidget(legal, 1)
        skip = QPushButton("ENTER DESKTOP  →")
        skip.clicked.connect(self.close)
        footer.addWidget(skip)
        outer.addLayout(footer)

    def open_app(self, program: str) -> None:
        self.notice.setText("Launching selected application…" if launch(program)
                            else "Application unavailable; open Synapse Control for diagnostics.")

    def closeEvent(self, event) -> None:
        mark_seen()
        super().closeEvent(event)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--first-run", action="store_true")
    args = parser.parse_args()
    if args.first_run and STATE_MARKER.exists():
        return 0
    if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        return 0 if args.first_run else 1
    app = QApplication(sys.argv[:1])
    widget = Welcome()
    widget.show()
    return app.exec()


if __name__ == "__main__":
    raise SystemExit(main())
