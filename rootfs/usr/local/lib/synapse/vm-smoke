#!/bin/sh
set -u

fail() {
  echo "SYNAPSE_VM_FAIL:$1"
  exit 1
}

pass() {
  echo "SYNAPSE_VM_PASS:$1"
}

check_cmd() {
  name="$1"
  binary="$2"
  echo "SYNAPSE_VM_CHECK:$name"
  if command -v "$binary" >/dev/null 2>&1; then
    pass "$name"
  else
    fail "$name"
  fi
}

check_file() {
  name="$1"
  path="$2"
  echo "SYNAPSE_VM_CHECK:$name"
  if test -s "$path"; then
    pass "$name"
  else
    fail "$name"
  fi
}

run_check() {
  name="$1"
  shift
  echo "SYNAPSE_VM_CHECK:$name"
  if "$@" >/dev/null 2>&1; then
    pass "$name"
  else
    fail "$name"
  fi
}

echo "SYNAPSE_VM_CHECK:os-release"
if grep -q '^ID=synapseos$' /etc/os-release; then
  pass "os-release"
else
  echo "SYNAPSE_VM_INFO:os-release=$(tr '\n' ' ' < /etc/os-release)"
  fail "os-release"
fi

check_cmd "synapse-cli" synapse
check_cmd "synflow-cli" synflow
cat >/tmp/synapse-v2-smoke.syn <<'EOF'
SYNAPSE/2
state x: int = 1
fn plus(v: int) -> int
    return v + 2
end
set x = plus(x)
assert x == 3
emit x
EOF
run_check "synflow-v2-check" synflow check /tmp/synapse-v2-smoke.syn
run_check "synflow-v2-compile" synflow compile /tmp/synapse-v2-smoke.syn -o /tmp/synapse-v2-smoke.synb
run_check "synflow-v2-run" synflow run /tmp/synapse-v2-smoke.synb
run_check "synflow-v2-native" synflow native /tmp/synapse-v2-smoke.syn -o /tmp/synapse-v2-native
run_check "synflow-v2-native-run" /tmp/synapse-v2-native
check_cmd "synapse-control" synapse-control
check_cmd "plasma" plasmashell
check_cmd "calamares" calamares
check_cmd "pipewire" pipewire
run_check "python-package" python3 -c 'import sys; sys.path.insert(0, "/usr/lib/synapse/python"); import synapse'
run_check "hardware-package" python3 -c 'import sys; sys.path.insert(0, "/usr/lib/synapse/python"); from synapse.hardware import probe_hardware; assert "arch" in probe_hardware()'
run_check "control-dependencies" python3 -c 'import PyQt6, psutil'
run_check "native-abi-linker-cache" sh -c 'ldconfig -p | grep -q "libsynapse_abi.so"'
check_file "native-abi-header" /usr/include/synapse/synapse.h
cat >/tmp/synapse-abi-smoke.c <<'EOF'
#include <stdint.h>
#include <synapse/synapse.h>
int main(void) { return synapse_abi_version() == 1u ? 0 : 1; }
EOF
run_check "native-abi-compile" cc /tmp/synapse-abi-smoke.c -lsynapse_abi -o /tmp/synapse-abi-smoke
run_check "native-abi-run" /tmp/synapse-abi-smoke
check_file "hardware-registry" /usr/share/synapse/hardware/profiles.json
check_file "wallpaper" /usr/share/wallpapers/SynapseOS/contents/images/3840x2160.svg
check_file "sddm-theme" /usr/share/sddm/themes/synapse-nebula/Main.qml
check_file "plymouth-theme" /usr/share/plymouth/themes/synapse-nebula/synapse-nebula.plymouth
check_file "grub-theme" /usr/share/grub/themes/synapse-nebula/theme.txt
run_check "synapse-status" synapse status
run_check "synapse-doctor" synapse doctor
run_check "synapse-agent" systemctl is-active --quiet synapse-agent.service
run_check "network-manager" systemctl is-active --quiet NetworkManager.service

echo "SYNAPSE_VM_READY"
